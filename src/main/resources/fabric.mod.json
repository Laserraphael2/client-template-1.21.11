{
	"schemaVersion": 1,
	"id": "client",
	"version": "${version}",
	"name": "Xenon Client",
	"description": "Modern Minecraft HUD client with Arctic Glow glassmorphic UI. Features customizable modules, keybinds, and ultra-clean white design.",
	"authors": [
		"rapha"
	],
	"contact": {
		"homepage": "https://github.com/Laserraphael2/client-template-1.21.11",
		"sources": "https://github.com/Laserraphael2/client-template-1.21.11"
	},
	"license": "CC0-1.0",
	"icon": "assets/client/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"mod.client.Client"
		],
		"client": [
			"mod.client.client.ClientClient"
		]
	},
	"mixins": [
		"client.mixins.json",
		{
			"config": "client.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}